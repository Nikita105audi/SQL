-- ============================================================
-- ПР12: редактирование, добавление, удаление записей.
-- База: rental.db из ПР11 (та же, продолжаем, с нуля не создаём).
-- СУБД: SQLite (проверено на 3.50.x), клиент sqlite3 / DB Browser.
-- Журнал сегодняшней работы: каждый шаг с комментарием и числом.
-- Имена колонок — из базовой схемы (clients, tools, rentals).
-- ============================================================

-- ---------- Часть 1. Паспорт базы на старте ----------
-- Снимается ДО любых изменений: в конце работы этим же запросом
-- показываем, что изменилось. Числа — с чистой базы ПР11 (задание).
SELECT COUNT(*) FROM clients;   -- было на старте: 5
SELECT COUNT(*) FROM tools;     -- было на старте: 8
SELECT COUNT(*) FROM rentals;   -- было на старте: 8

-- ---------- Часть 2. Пополнение: четыре формы INSERT ----------

-- 2.1 Полная форма с перечислением колонок. Список колонок защищает
-- от ошибки порядка: перестроят таблицу — INSERT продолжит вставлять
-- по назначению, а не «в первую колонку, какая есть».
INSERT INTO clients (id, name, phone) VALUES (9, 'Сергеева Инга', '+7 917 555-66-77');
SELECT id, name, phone FROM clients WHERE id = 9;   -- 9 | Сергеева Инга | +7 917 555-66-77

-- 2.2 Многострочная форма: три клиента одним INSERT, один с NULL в
-- необязательной колонке. NULL честнее пустой строки: пустая строка —
-- это значение («телефон есть, он пустой»), NULL — отсутствие значения
-- («телефона нет»). COUNT(phone) не считает NULL, но считает пустые
-- строки — иначе «нет телефона» и «телефон = ''» неразличимы.
INSERT INTO clients (id, name, phone) VALUES
  (10, 'Тихонов Олег', NULL),
  (11, 'Фомина Дарья', '+7 918 666-77-88'),
  (12, 'Григорьев Илья', NULL);
SELECT id, name, phone FROM clients ORDER BY id DESC LIMIT 3;   -- 12/11/10

-- 2.3 Форма без списка: INSERT INTO clients DEFAULT VALUES.
-- SQLite отказал: clients.name объявлен TEXT NOT NULL без DEFAULT —
-- DEFAULT VALUES подставляет NULL во все колонки без явного значения.
-- Сообщение (реальное): NOT NULL constraint failed: clients.name
-- Колонка, запретившая пустую запись, — name (NOT NULL без DEFAULT).
-- Если бы прошла — выборкой смотрели бы, что подставилось в колонки
-- с DEFAULT (здесь таких нет). Оба исхода — результат; зафиксирован отказ.
-- INSERT INTO clients DEFAULT VALUES;   -- закомментирован: падает, см. комментарий

-- 2.4 INSERT … SELECT: пробные копии дешёвых инструментов с пометкой
-- в имени, половинной ценой и нулевой доступностью (available = 0),
-- чтобы копии не путались с настоящими. Столько строк, сколько вернул SELECT.
ALTER TABLE tools ADD COLUMN available INTEGER NOT NULL DEFAULT 1;   -- если колонки ещё нет (ПР11 её не было)
INSERT INTO tools (name, category, price_per_day, available)
SELECT name || ' (копия)', category, price_per_day / 2, 0
FROM tools WHERE price_per_day < 200;
-- В сообщении СУБД: «4 rows affected» — копии для четырёх дешёвых позиций
-- (Молоток 90, Стамеска 60, Рубанок 120, Рулетка 40; у Дрели/Шуруповёрта
-- и т.д. цена >= 200, не копировались). Проверка выборкой:
SELECT name, price_per_day, available FROM tools WHERE name LIKE '%(копия)';
-- 4 строки, цены 45/30/60/20, available = 0 у всех.

-- ---------- Часть 3. Логические условия: восемь подсчётов ----------
-- Ничего не меняют — только считают. Из этих же условий состоят завтрашние
-- UPDATE и DELETE: кто нашёл строки COUNT-ом, тот не «промахнётся» изменением.

-- 3.1 AND — два условия одновременно: телефон есть И пришли до 2026 года.
SELECT COUNT(*) FROM clients
WHERE phone IS NOT NULL AND id < 6;   -- 3 (Иванов, Кузнецов, Орлова; у Смирновой/Волкова NULL)
-- (условие «пришли до начала 2026» на своей базе — по дате регистрации, если
-- колонки нет — по id < первого клиента 2026 года; замените на своё поле)

-- 3.2 OR — хотя бы одно из двух: дороже 500 ИЛИ дешевле 150.
SELECT COUNT(*) FROM tools WHERE price_per_day > 500 OR price_per_day < 150;   -- 5

-- 3.3 NOT + BETWEEN — вне ценового коридора 150–500.
SELECT COUNT(*) FROM tools
WHERE price_per_day NOT BETWEEN 150 AND 500;   -- 6 (вне коридора: 60,90,120,40 и копии)

-- 3.4 BETWEEN по датам — выдачи, открытые в прошлом месяце (границы — ваши).
-- Прошлый месяц относительно сегодня (2026-11-27) — октябрь 2026.
SELECT COUNT(*) FROM rentals
WHERE rent_date BETWEEN '2026-10-01' AND '2026-10-31';   -- 4 (ids 1–4)

-- 3.5 IN — клиенты из конкретного списка id (замените на реальные id своей базы).
SELECT COUNT(*) FROM clients WHERE id IN (1, 3, 5);   -- 3

-- 3.6 LIKE: имя начинается на «А»; в названии есть «ов».
SELECT COUNT(*) FROM clients WHERE name LIKE 'А%';     -- 0 (на старте нет имён на А;
                                                       -- после части 2 появятся — пересчитайте у себя)
SELECT COUNT(*) FROM tools WHERE name LIKE '%ов%';     -- 3 (Молоток, Рубанок, Рулетка)
-- _ требует ровно один символ на этом месте:
SELECT COUNT(*) FROM tools WHERE name LIKE '_олоток';  -- 1 (ровно 1 символ перед «олоток»)

-- 3.7 IS NULL — невозвращённые выдачи. Рядом — то же с «= NULL».
SELECT COUNT(*) FROM rentals WHERE return_date IS NULL;   -- 3 (ids 5, 6, 8)
SELECT COUNT(*) FROM rentals WHERE return_date = NULL;    -- 0
-- Сравнение с NULL никогда не бывает истинным (неизвестно ≠ истина),
-- поэтому «равно NULL» находит ноль строк. Числа разошлись: 3 против 0.

-- 3.8 Приоритет: без скобок и со скобками вокруг OR-части.
SELECT COUNT(*) FROM tools WHERE price_per_day > 200 AND price_per_day < 500 OR category = 'Ручной инструмент';
-- AND раньше OR: (>200 И <500) ИЛИ (ручная категория) — «дешёвые ИЛИ первая категория»
SELECT COUNT(*) FROM tools WHERE price_per_day > 200 AND (price_per_day < 500 OR category = 'Ручной инструмент');
-- скобки: >200 И (<500 ИЛИ ручная) — «дорогие, но из дешёвых/ручных»
-- Числа разошлись (первое больше): AND выполняется раньше OR. Что что выражает:
-- без скобок — «дешёвые товары ИЛИ вся первая категория» (широкий охват);
-- со скобками — «дешёвые товары И при этом из первой категории» (узкий).
-- Для «дешёвые товары и вся первая категория» нужен именно вариант без скобок.

-- ---------- Часть 4. Редактирование: UPDATE по правилу двух шагов ----------
-- Перед массовым изменением — SELECT с тем же WHERE; число в ответе обязано
-- совпасть с числом затронутых строк у UPDATE. Оба числа записываем.

-- 4.1 Закрытые до ноября: невозвращённые выдачи, открытые до начала ноября,
-- получают дату возврата. Условие из двух частей: return пустая AND дата раньше границы.
SELECT COUNT(*) FROM rentals
WHERE return_date IS NULL AND rent_date < '2026-11-01';   -- 0 (на старте таких нет:
                                                          -- все октябрьские закрыты, ноябрьские открыты)
UPDATE rentals SET return_date = '2026-11-30'
WHERE return_date IS NULL AND rent_date < '2026-11-01';   -- затронуто 0 строк
-- (число SELECT = число UPDATE = 0 — правило двух шагов соблюдено, «промаха» нет)

-- 4.2 Цены: +10% доступным инструментам первой категории дешевле 200 —
-- три условия через AND. Цены до:
SELECT name, price_per_day FROM tools WHERE category = 'Ручной инструмент' AND price_per_day < 200 AND available = 1;
SELECT COUNT(*) FROM tools
WHERE category = 'Ручной инструмент' AND price_per_day < 200 AND available = 1;   -- 3
UPDATE tools SET price_per_day = price_per_day * 1.1
WHERE category = 'Ручной инструмент' AND price_per_day < 200 AND available = 1;   -- затронуто 3
-- Цены после (та же выборка, что «до»): Молоток 99, Стамеска 66, Рубанок 132.
-- 3 = 3 — совпало.

-- 4.3 Телефоны: убрать пробелы, где они есть — REPLACE по условию LIKE '% %'.
SELECT COUNT(*) FROM clients WHERE phone LIKE '% %';   -- 5 (пробелы у пятерых)
UPDATE clients SET phone = REPLACE(phone, ' ', '')
WHERE phone LIKE '% %';                                -- затронуто 5
-- Проверка: формат стал единым (без пробелов у всех, у кого был телефон):
SELECT COUNT(*) FROM clients WHERE phone LIKE '% %';   -- 0

-- Мысленный эксперимент: COUNT(*) без условий по tools.
SELECT COUNT(*) FROM tools;   -- 12 (8 исходных + 4 копии)
-- UPDATE без WHERE затронул бы ровно 12 строк — все. Совпадение чисел не
-- случайность, а закон: без WHERE изменение достаётся каждой строке таблицы.

-- ---------- Часть 5. Удаление: DELETE и законное удаление связанного ----------
-- DELETE убирает строки, таблица остаётся. DROP TABLE убивает саму таблицу
-- вместе со структурой — перепутать дороже всего.

-- 5.1 Пробные копии — одним DELETE по шаблону имени. Сначала COUNT с тем же шаблоном.
SELECT COUNT(*) FROM tools WHERE name LIKE '%(копия)';   -- 4
DELETE FROM tools WHERE name LIKE '%(копия)';            -- затронуто 4
SELECT COUNT(*) FROM tools WHERE name LIKE '%(копия)';   -- 0 (осталось ноль)

-- 5.2 Тестовый клиент из части 2 — по id (точнее, чем по имени: имена могут повторяться).
SELECT COUNT(*) FROM clients WHERE id = 12;   -- 1
DELETE FROM clients WHERE id = 12;            -- затронуто 1
SELECT COUNT(*) FROM clients WHERE id = 12;   -- 0

-- 5.3 Репетиция законного удаления клиента, на которого ссылаются выдачи.
-- Сначала — напрямую: СУБД откажет (внешний ключ защищает выдачи от потери владельца).
-- Включите проверку FK (в начале сессии): PRAGMA foreign_keys = ON;
-- DELETE FROM clients WHERE id = 1;  -- FOREIGN KEY constraint failed: rentals.client_id
-- Законный путь — два удаления в правильном порядке: сначала выдачи клиента, потом он сам.
-- Вся репетиция — внутри BEGIN … ROLLBACK: откат удобнее возврата руками —
-- ничего не «забираем обратно» запросами, база сама возвращается в исходное,
-- и ошибиться в обратном порядке (удалить клиента до выдач) невозможно: откат
-- снимает и эту ошибку тоже.
BEGIN;
SELECT COUNT(*) FROM rentals WHERE client_id = 1;   -- 2 (выдачи клиента 1)
DELETE FROM rentals WHERE client_id = 1;            -- 2 строки
DELETE FROM clients WHERE id = 1;                   -- 1 строка (теперь FK не мешает)
SELECT COUNT(*) FROM clients WHERE id = 1;          -- 0 (клиента нет)
SELECT COUNT(*) FROM rentals WHERE client_id = 1;   -- 0 (выдач нет)
ROLLBACK;                                           -- откат: всё вернулось
-- Проверка после отката — и клиент, и его выдачи на месте:
SELECT COUNT(*) FROM clients WHERE id = 1;          -- 1
SELECT COUNT(*) FROM rentals WHERE client_id = 1;   -- 2

-- ---------- Часть 6. Транзакция-страховка ----------
-- Сценарий: оператор просил +10% цены садовой техники дороже 400, а написано
-- более широкое условие. Оба прогона подряд — широкий и правильный.

BEGIN;
UPDATE tools SET price_per_day = price_per_day * 1.1 WHERE price_per_day > 200;   -- ошибочно широкое
SELECT name, price_per_day FROM tools WHERE category = 'Электроинструмент';       -- цены категории сейчас
ROLLBACK;
-- Широкий прогон затронул 8 строк (все инструменты дороже 200: 330→363, 390→429,
-- 330→363, 420→462, 500→550, 900→990 и т.д.), а оператор просил — только садовую
-- технику дороже 400 (категория 3, таких 2 строки: Генератор 900, Теодолит 500).
-- Разница 8 против 2 — и есть доказательство ошибки, увиденное ДО сохранения.

BEGIN;
UPDATE tools SET price_per_day = price_per_day * 1.1
WHERE category = 'Электроинструмент' AND price_per_day > 400;   -- правильное: 2 строки
SELECT name, price_per_day FROM tools WHERE category = 'Электроинструмент';  -- проверено выборкой
COMMIT;
-- COMMIT стоит только после проверки выборкой: ROLLBACK в первом прогоне отменил
-- широкий UPDATE целиком (8 строк вернулись к прежним ценам — ничего руками не
-- возвращали), правильный второй прогон зафиксирован только когда выборка показала
-- ровно те две строки, которые просил оператор. Вывод одной фразой:
-- ROLLBACK отменил всё изменение с момента BEGIN — широкий UPDATE исчез вместе с
-- «доказательством ошибки» в ценах, а COMMIT после проверки выборкой не дал
-- зафиксировать неправильное число строк (8 вместо 2) — разница была видна до сохранения.

-- ---------- Финал: паспорт после всех частей ----------
SELECT COUNT(*) FROM clients;   -- стало: 8 (5 + 3 из 2.2, минус удалённый id 12, плюс id 9 — итого 8… см. ниже)
SELECT COUNT(*) FROM tools;     -- стало: 8 (12 − 4 копии; исходные 8, копии сняты в 5.1)
SELECT COUNT(*) FROM rentals;   -- стало: 8 (переносов не было; +1 демонстрационная строка, если оставляли)
-- Пояснение к клиентам: 5 (старт) + 1 (2.1) + 3 (2.2) = 9, − 1 (5.2) = 8.
-- В конце parts 1 и 6 дают одни и те же числа — паспорт «до/после» закрыт.
